include run.py bootstrap.py start.sh start.command start.cmd config.example.toml .gitattributes .gitignore
include docs/architecture.md docs/configuration.md docs/development.md docs/troubleshooting.md docs/raspberry-pi.md
recursive-include scripts *.py *.sh
recursive-include deploy *.service *.desktop *.sh
recursive-include tests *.py *.cjs
recursive-include src/now_playing/web *
global-exclude *.py[cod] .DS_Store
prune docs/superpowers
prune output
prune data
prune models
